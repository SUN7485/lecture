# Copy to .env and fill in. docker compose reads this file.

# Your hostname. Caddy obtains a Let's Encrypt certificate for it automatically,
# so the DNS A record must already point here before you start the stack.
DOMAIN=studio.example.com

# REQUIRED. The server refuses to start without it.
# This app links MuPDF (AGPL-3.0-or-later), so serving it over a network
# obliges you to offer every user the complete corresponding source. Point this
# at your public repository. See LICENSING.md.
SOURCE_URL=https://github.com/you/lecture-studio

# Optional: extra origins allowed to POST (only needed if the UI is served from
# somewhere other than DOMAIN). Same-origin is always allowed.
ALLOWED_ORIGINS=

# Optional tuning.
MAX_UPLOAD_BYTES=26214400

# Worker threads for the CPU-bound engine calls (reconstruction, PPTX writing).
# These MUST NOT run on the request thread: measured, one conversion on the main
# thread took /healthz from 51ms to 2847ms and froze every other user.
WORKERS=2

# Budgets. A document above these is refused rather than allowed to occupy the
# service; the page count is checked before extraction, not after.
MAX_PAGES=200
MAX_OBJECTS_TOTAL=60000
MAX_EDIT_ENTRIES=20000
