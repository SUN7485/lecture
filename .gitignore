node_modules/
dist/
*.log
Thumbs.db
.DS_Store

# API keys — never commit. Copy config.example.json → config.json and fill in.
config.json
# Per-lecture enrichment cache (generated visuals) sits next to the source file.
*.enrich.json

# Python PPTX export
tools/pptx/__pycache__/
*.pptx

# Claude Code tooling (handoffs, local settings) — not part of the project.
.claude/
# External-agent rules copies (distributed from Downloads master) — not project code.
.clinerules/
.kilocode/
.kilo/

# Verifier screenshots — evidence, regenerated on every run.
verify-*.png

# PPTX fidelity evidence + local caches — generated artifacts, never source.
# .fidelity/ holds the last 10 verification runs (renders, heatmaps, reports).
.cache/
.fidelity/
.tmp-fidelity-fonts/
# Scratch experiment deps (the scaffold itself is pruned in mission 033).
bnb_html_match/node_modules/

# Merge scratch: rendered deck previews and source-page rasters (regenerated).
.preview/
# The vendored PDF engine's image cache (content-hashed, rebuilt on import).
engine/.cache/

# Vendored engine: local commercial-engine build output and licenses
# (same exclusions as D:\pdf=ppt — a 60MB Aspose DLL must never be committed).
engine/experiments/vendors/aspose-runner/bin/
engine/experiments/vendors/aspose-runner/obj/
engine/experiments/vendors/**/*.lic
engine/experiments/vendors/**/*license*
